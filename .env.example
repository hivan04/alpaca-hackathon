# ---------------------------------------------------------------------------
# Alpaca credentials. NEVER commit the real .env.
# Copy to .env and fill in.  cp .env.example .env
# ---------------------------------------------------------------------------

# --- JUDGED paper account (the account ID you submit to the hackathon) -------
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# --- DEV/throwaway paper account (used for all debugging) -------------------
# `oaa` picks these up when profile=dev so the judged account stays clean.
ALPACA_DEV_API_KEY=
ALPACA_DEV_SECRET_KEY=

# Record this on day one. Required at submission.
ALPACA_JUDGED_ACCOUNT_ID=

# --- Which profile is active: dev | judged ----------------------------------
OAA_PROFILE=dev

# --- Optional overrides ------------------------------------------------------
# OAA_CONFIG=config/default.yaml
# OAA_LOG_LEVEL=INFO

# --- LLM provider for the reasoning agents ----------------------------------
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- Technology partner credentials (filled in at kickoff) ------------------
# See docs/PARTNERS.md. Each partner adapter reads its own prefixed vars.
# PARTNER_<NAME>_API_KEY=

# NOTE: paper vs live is NOT set here. It lives in config/*.yaml as `broker.paper`,
# and every broker/data path forces it onto the subprocess environment from there.
# That is deliberate: a live-trading switch must not be environment-dependent,
# invisible in the repo, and different on every machine. Setting
# ALPACA_PAPER_TRADE in this file has no effect - `oaa doctor` will tell you so.
