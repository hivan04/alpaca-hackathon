+# --------------------------------------------------------------------------- #
+# entry re-pricing vs the sizing denominator
+#
+# `_open_structure` re-prices an intraday entry onto the model surface AFTER
+# the risk engine has already sized the position from the chain quote the idea
+# was built from. On a debit structure max loss IS the debit, so the two
+# disagreeing means the position is sized against a number that no longer
+# exists - and `pnl_pct` divides by the same stale `max_loss`, so the exit
+# dials move with it.
+#
+# Measured over 2026-02-01..08-21: 15 of 243 `single_long` trades carried more
+# than 1.5x their recorded max loss, 6 more than 3x, worst $3,813 of premium
+# against a $1,000 cap. BT0038 (QQQ 0 DTE, built at 0.93, filled at 4.11, q10)
+# was +$700 on 4.4x the intended risk and was 83% of that week's headline P&L.
+# --------------------------------------------------------------------------- #
+def _debit_idea(max_loss: float) -> TradeIdea:
+    return TradeIdea(
+        symbol="QQQ",
+        strategy="intraday_momentum",
+        structure=StructureType.SINGLE_LONG,
+        legs=[Leg(symbol="QQQ260821P00714000", side=Side.BUY, intent=Intent.BUY_TO_OPEN)],
+        quantity=10,
+        net_price=round(max_loss / 100, 4),
+        max_loss=max_loss,
+        max_profit=None,
+        thesis="test",
+    )
+
+
+def _open_with_fill(engine, idea, quantity, fill_price, result):
+    """Drive _open_structure with a known fill, bypassing the chain."""
+    engine._net_price = lambda legs, marks, closing: (fill_price, 0.0)
+    strategy = SimpleNamespace(name="intraday_momentum", params={}, book="intraday")
+    market = _spy_context(600.0)
+    market.symbol = "QQQ"
+    engine._open_structure(
+        idea, strategy, market, quantity,
+        dt.datetime(2026, 8, 21, 14, 0, tzinfo=dt.timezone.utc),
+        {}, {}, result,
+    )
+
+
+def test_a_repriced_entry_resizes_to_the_true_risk():
+    engine = BacktestEngine(load_settings())
+    result = BacktestResult()
+    idea = _debit_idea(93.0)          # built at 0.93
+    _open_with_fill(engine, idea, 10, 4.1141, result)   # filled at 4.11
+
+    assert result.trades, "the trade should still open, at a smaller size"
+    opened = result.trades[0]
+    # 1% of $100k = $1,000 budget; $411.41 per contract allows 2, not 10.
+    assert opened.quantity == 2, f"expected a resize to 2, got {opened.quantity}"
+    assert opened.max_loss == pytest.approx(411.41), (
+        "the record must carry the FILLED debit, not the built quote - the exit "
+        "denominator reads it"
+    )
+
+
+def test_an_unchanged_entry_price_is_left_alone():
+    engine = BacktestEngine(load_settings())
+    result = BacktestResult()
+    idea = _debit_idea(411.41)
+    _open_with_fill(engine, idea, 2, 4.1141, result)
+    assert result.trades[0].quantity == 2, "no resize when the surfaces agree"
+
+
+def test_a_reprice_that_breaches_the_cap_on_one_contract_is_refused():
+    engine = BacktestEngine(load_settings())
+    result = BacktestResult()
+    idea = _debit_idea(93.0)
+    _open_with_fill(engine, idea, 10, 15.00, result)   # $1,500 for ONE contract
+
+    assert not result.trades, "one contract over the cap must not open"
+    assert result.rejections, "and it must be journalled, not dropped silently"
+    assert result.rejections[-1].vetoed_by == "reprice_risk"
+
+
+def test_a_credit_structure_is_untouched_by_the_guard():
+    """max_loss on a credit structure is a strike WIDTH, not the net price, so
+    it cannot go stale this way and must not be overwritten by it."""
+    engine = BacktestEngine(load_settings())
+    result = BacktestResult()
+    idea = TradeIdea(
+        symbol="SPY", strategy="vol_carry", structure=StructureType.IRON_CONDOR,
+        legs=[
+            Leg(symbol="SPY260918P00475000", side=Side.SELL, intent=Intent.SELL_TO_OPEN),
+            Leg(symbol="SPY260918P00470000", side=Side.BUY, intent=Intent.BUY_TO_OPEN),
+        ],
+        quantity=3, net_price=-2.0, max_loss=300.0, max_profit=200.0, thesis="test",
+    )
+    _open_with_fill(engine, idea, 3, -2.0, result)      # a credit: net < 0
+    assert result.trades[0].quantity == 3
+    assert result.trades[0].max_loss == pytest.approx(300.0)
