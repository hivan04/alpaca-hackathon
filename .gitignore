# secrets
.env
.env.*
!.env.example
config/local.yaml
config/*.local.yaml
secrets/

# python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# runtime artifacts
runs/
# ...except the handful of runs chosen for the public dashboard.
# `runs/` has no leading slash, so it matches at ANY depth - without
# this, public/runs/ is silently ignored and the deployed page boots
# with an empty backtest history. See scripts/publish_runs.py.
!public/runs/
!public/runs/**
data/cache/
logs/
*.sqlite
*.db
*.log

# os / editor
.DS_Store
.idea/
.vscode/
!.vscode/mcp.json
!.vscode/launch.json
!.vscode/settings.json
!.vscode/tasks.json

# claude files
.agents/
.claude/

# Generated per-day judged reports, same treatment as runs/.
reports/
# Same trap as runs/: no leading slash means `reports/` matches at ANY depth,
# so public/reports/ is ignored too without these - and the deployed Daily
# Reports tab boots empty with no error anywhere.
!public/reports/
!public/reports/**

# scratch: junk moved out of the repo root, safe to delete by hand
_to_delete/
