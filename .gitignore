# secrets
.env
.env.*
!.env.example
config/local.yaml
config/*.local.yaml
secrets/

# python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# runtime artifacts
runs/
# ...except the handful of runs chosen for the public dashboard.
# `runs/` has no leading slash, so it matches at ANY depth - without
# this, public/runs/ is silently ignored and the deployed page boots
# with an empty backtest history. See scripts/publish_runs.py.
!public/runs/
!public/runs/**
data/cache/
logs/
*.sqlite
*.db
*.log

# os / editor
.DS_Store
.idea/
.vscode/
!.vscode/mcp.json
!.vscode/launch.json
!.vscode/settings.json
!.vscode/tasks.json
